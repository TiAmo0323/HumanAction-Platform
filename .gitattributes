# 统一文本文件换行符；Windows BAT 使用 CRLF，其余源码统一 LF。
* text=auto

*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
